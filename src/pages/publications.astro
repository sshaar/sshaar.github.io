---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import PublicationList from '../components/PublicationList.tsx';
import { publications, ME } from '../data/publications';
import { projects } from '../data/projects';

const pubs = [...publications].sort((a, b) => b.year - a.year);
---

<BaseLayout
  title="Publications"
  description="Full list of publications by Shaden Shaar."
>
  <div class="container-wide pt-14 md:pt-20">
    <section class="pb-10">
      <ScrollReveal>
        <p class="section-label mb-3">Publications</p>
        <h1 class="font-serif text-4xl leading-tight text-ink dark:text-zinc-100 md:text-5xl">
          Publications
        </h1>
        <p class="mt-4 max-w-2xl leading-relaxed text-ink-muted dark:text-zinc-300">
          {publications.length} papers across {projects.length} research threads. Filter by
          project or search to narrow down. Also on
          <a href="https://scholar.google.com/citations?user=yMArLRcAAAAJ" class="link">Google Scholar</a>.
        </p>
      </ScrollReveal>
    </section>

    <section class="pb-24">
      <ScrollReveal>
        <PublicationList client:load publications={pubs} projects={projects} me={ME} />
      </ScrollReveal>
    </section>
  </div>
</BaseLayout>
