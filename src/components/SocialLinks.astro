---
interface Props {
  class?: string;
  iconSize?: number;
}

const { class: className = '', iconSize = 18 } = Astro.props;

const links = [
  {
    label: 'Email',
    href: 'mailto:sshaar31@gmail.com',
    svg: `<svg width="${iconSize}" height="${iconSize}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>`,
  },
  {
    label: 'Google Scholar',
    href: 'https://scholar.google.com/citations?user=yMArLRcAAAAJ',
    svg: `<svg width="${iconSize}" height="${iconSize}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.749-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>`,
  },
  {
    label: 'GitHub',
