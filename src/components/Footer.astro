---
import SocialLinks from './SocialLinks.astro';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 px-5 py-10 text-sm text-ink-muted dark:text-zinc-400 sm:flex-row sm:items-center sm:px-8">
    <div>
      <p class="text-ink dark:text-zinc-200">Shaden Shaar</p>
      <p class="mt-0.5 text-xs text-ink-subtle dark:text-zinc-500">
        PhD candidate, Cornell CS · © {year}
      </p>
    </div>
    <SocialLinks iconSize={17} />
  </div>
</footer>
