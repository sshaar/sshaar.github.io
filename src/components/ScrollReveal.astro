---
interface Props {
  as?: string;
  class?: string;
  delay?: number;
}
const { as: Tag = 'div', class: className = '', delay = 0 } = Astro.props;
---

<Tag class={`animate-reveal ${className}`} data-reveal-delay={delay}>
  <slot />
</Tag>

<script>
  // Fallback: if IntersectionObserver is unavailable, reveal everything immediately.
  if (!('IntersectionObserver' in window)) {
    for (const el of document.querySelectorAll('.animate-reveal')) {
      el.classList.add('is-visible');
    }
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const delay = Number(el.dataset.revealDelay ?? 0);
            setTimeout(() => el.classList.add('is-visible'), delay);
            observer.unobserve(el);
          }
        }
      },
      { threshold: 0, rootMargin: '0px 0px -10% 0px' },
    );
    for (const el of document.querySelectorAll('.animate-reveal')) {
      observer.observe(el);
    }

    // Safety net: if for any reason the observer hasn't revealed an element
    // within 1.2s (e.g., a very tall element whose threshold never triggers),
    // force it visible so nothing stays invisible.
    setTimeout(() => {
      for (const el of document.querySelectorAll('.animate-reveal:not(.is-visible)')) {
        el.classList.add('is-visible');
      }
    }, 1200);
  }
</script>
