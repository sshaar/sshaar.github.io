---
/**
 * ai-2027-style scrolling sidebar.
 *
 * Two-level timeline:
 *  - h2 sections are always visible, laid out in compact equal slots.
 *  - h3.toc-item sub-markers are only visible when their parent section is
 *    active. The active section's slot expands to house its sub-dots; other
 *    sections collapse to the base slot size.
 *  - Sub-dots animate out from / into their parent h2 position as sections
 *    open and close, so empty space never lingers.
 *
 * Re-renders automatically when the tracked heading set changes (e.g. when a
 * React island like PublicationList filters its list).
 */
interface Props {
  selector?: string;
}
const { selector = 'h2' } = Astro.props;
---

<aside
  id="toc-root"
  data-toc-selector={selector}
  class="section-nav hidden md:block fixed left-3 lg:left-6 xl:left-8 top-24 w-[180px] z-10 pointer-events-none"
  style="height: calc(100vh - 8rem);"
  aria-hidden="true"
>
  <div class="relative h-full pointer-events-auto">
    <svg
      id="toc-svg"
      class="absolute top-0 left-0 h-full w-full text-ink dark:text-zinc-200 opacity-0 transition-opacity duration-500"
      preserveAspectRatio="none"
    ></svg>
    <ul
      id="toc-list"
      class="relative h-full list-none m-0 p-0"
      aria-label="Section navigation"
    ></ul>
  </div>
</aside>

<script is:inline>
  function initToc() {
    const root = document.getElementById('toc-root');
    const svg = document.getElementById('toc-svg');
    const list = document.getElementById('toc-list');
    if (!root || !svg || !list) return;

    const content = document.querySelector('[data-toc-content]');
    const selector = root.getAttribute('data-toc-selector') || 'h2';
    if (!content) {
      root.style.display = 'none';
      return;
    }

    const slugify = (s) =>
      s.toLowerCase().trim().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const STICKY_HEADER_OFFSET = 100;

    const MINI_SLOT = 18;   // compact h2 when clustered at edges
    const Y_START = 10;
    const Y_END_PAD = 12;
    const ACTIVE_BUFFER = 22; // gap between active h2 and its first sub

    let allHeadings = [];
    let parentOf = new Map();
    let sectionIds = [];
    let subsBySection = new Map();
    let activeSection = null;
    let lastSignature = '';

    function queryHeadings() {
      const found = Array.from(content.querySelectorAll(selector)).filter(
        (h) => !!h.textContent && h.textContent.trim(),
      );
      found.forEach((h) => {
        if (!h.id) h.id = slugify(h.textContent);
      });
      return found;
    }

    function rebuildIndex() {
      allHeadings = queryHeadings();
      parentOf = new Map();
      sectionIds = [];
      subsBySection = new Map();
      let cur = null;
      for (const h of allHeadings) {
        if (h.tagName.toLowerCase() === 'h2') {
          cur = h.id;
          sectionIds.push(h.id);
          parentOf.set(h.id, null);
          subsBySection.set(h.id, []);
        } else if (cur) {
          parentOf.set(h.id, cur);
          subsBySection.get(cur).push(h.id);
        }
      }
    }

    function computeActiveSection() {
      let active = null;
      const threshold = window.scrollY + STICKY_HEADER_OFFSET + 10;
      for (const id of sectionIds) {
        const el = document.getElementById(id);
        if (!el) continue;
        const top = el.getBoundingClientRect().top + window.scrollY;
        if (top <= threshold) active = id;
        else break;
      }
      return active;
    }

    /**
     * Compute a layout map: id → y, visible.
     *
     * Two modes:
     *  - "expanded": when the active section has sub-headings, those subs
     *    spread across most of the sidebar height. H2s before the active
     *    section cluster at the top; h2s after it cluster at the bottom.
     *  - "compact": otherwise, h2s distribute evenly across the sidebar and
     *    all subs are hidden at their parent's position.
     */
    function computeLayout() {
      const positions = new Map();
      const visibilities = new Map();
      const height = root.clientHeight;
      const yStart = Y_START;
      const yEnd = height - Y_END_PAD;
      const yRange = Math.max(1, yEnd - yStart);
      const n = sectionIds.length;
      const activeSubs = activeSection ? subsBySection.get(activeSection) || [] : [];
      const expanded = activeSubs.length > 0;

      if (expanded) {
        const activeIdx = sectionIds.indexOf(activeSection);
        const before = sectionIds.slice(0, activeIdx);
        const after = sectionIds.slice(activeIdx + 1);
        const topBlock = before.length * MINI_SLOT;
        const bottomBlock = after.length * MINI_SLOT;

        before.forEach((sid, i) => {
          positions.set(sid, yStart + i * MINI_SLOT);
          visibilities.set(sid, true);
        });

        const mainStart = yStart + topBlock + (before.length ? 6 : 0);
        positions.set(activeSection, mainStart);
        visibilities.set(activeSection, true);

        const mainEnd = yEnd - bottomBlock - (after.length ? 6 : 0);
        const subStart = mainStart + ACTIVE_BUFFER;
        const subSpaceEnd = Math.max(subStart + 1, mainEnd);
        const subRange = subSpaceEnd - subStart;
        const stride = activeSubs.length > 1 ? subRange / (activeSubs.length - 1) : 0;

        activeSubs.forEach((subId, i) => {
          positions.set(subId, activeSubs.length === 1 ? subStart + subRange / 2 : subStart + i * stride);
          visibilities.set(subId, true);
        });

        after.forEach((sid, i) => {
          positions.set(sid, yEnd - (after.length - i) * MINI_SLOT);
          visibilities.set(sid, true);
        });

        // Park inactive subs at their parent's position, hidden
        sectionIds.forEach((sid) => {
          if (sid === activeSection) return;
          const parentY = positions.get(sid) ?? yStart;
          (subsBySection.get(sid) || []).forEach((subId) => {
            positions.set(subId, parentY);
            visibilities.set(subId, false);
          });
        });
      } else {
        // Compact — tight one-line stack at the top of the sidebar
        sectionIds.forEach((sid, i) => {
          const y = yStart + i * MINI_SLOT;
          positions.set(sid, y);
          visibilities.set(sid, true);
          (subsBySection.get(sid) || []).forEach((subId) => {
            positions.set(subId, y);
            visibilities.set(subId, false);
          });
        });
      }

      return { positions, visibilities };
    }

    function buildElements() {
      svg.innerHTML = '';
      list.innerHTML = '';

      const trackGroup = document.createElementNS(SVG_NS, 'g');
      trackGroup.setAttribute('id', 'toc-track-group');
      svg.appendChild(trackGroup);

      const fill = document.createElementNS(SVG_NS, 'line');
      fill.setAttribute('id', 'toc-fill');
      fill.setAttribute('x1', '3');
      fill.setAttribute('y1', String(Y_START));
      fill.setAttribute('x2', '3');
      fill.setAttribute('y2', String(Y_START));
      fill.setAttribute('stroke', 'currentColor');
      fill.setAttribute('stroke-width', '2');
      svg.appendChild(fill);

      allHeadings.forEach((h) => {
        const isTop = h.tagName.toLowerCase() === 'h2';
        const r = isTop ? 3.5 : 2.5;

        const g = document.createElementNS(SVG_NS, 'g');
        g.setAttribute('data-toc-g', h.id);
        g.style.transition =
          'transform 350ms cubic-bezier(0.22, 1, 0.36, 1), opacity 250ms ease';
        g.setAttribute('transform', `translate(0, ${Y_START})`);

        const ring = document.createElementNS(SVG_NS, 'circle');
        ring.setAttribute('cx', '3');
        ring.setAttribute('cy', '0');
        ring.setAttribute('r', String(r));
        ring.setAttribute('fill', 'currentColor');
        g.appendChild(ring);

        const inner = document.createElementNS(SVG_NS, 'circle');
        inner.setAttribute('data-toc-inner', h.id);
        inner.setAttribute('cx', '3');
        inner.setAttribute('cy', '0');
        inner.setAttribute('r', String(r - 1.2));
        inner.setAttribute('fill', 'var(--bg)');
        g.appendChild(inner);

        svg.appendChild(g);

        const li = document.createElement('li');
        li.setAttribute('data-toc-li', h.id);
        li.className =
          'absolute left-[14px] text-[11px] leading-tight whitespace-nowrap overflow-hidden text-ellipsis max-w-[164px] ' +
          (isTop
            ? 'text-ink dark:text-zinc-200 font-semibold'
            : 'text-ink-muted dark:text-zinc-400');
        li.style.top = `${Y_START - 7}px`;
        li.style.transition = 'top 350ms cubic-bezier(0.22, 1, 0.36, 1), opacity 250ms ease';
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent.trim();
        a.className =
          'no-underline transition-colors duration-200 hover:text-accent-700 dark:hover:text-accent-300';
        a.setAttribute('data-toc-label', h.id);
        li.appendChild(a);
        list.appendChild(li);
      });
    }

    function applyLayout() {
      const { positions, visibilities } = computeLayout();
      allHeadings.forEach((h) => {
        const g = svg.querySelector(`[data-toc-g="${CSS.escape(h.id)}"]`);
        const li = list.querySelector(`[data-toc-li="${CSS.escape(h.id)}"]`);
        if (!g || !li) return;
        const y = positions.get(h.id);
        const visible = visibilities.get(h.id);
        g.setAttribute('transform', `translate(0, ${y})`);
        g.style.opacity = visible ? '1' : '0';
        g.style.pointerEvents = visible ? '' : 'none';
        li.style.top = `${y - 7}px`;
        li.style.opacity = visible ? '1' : '0';
        li.style.pointerEvents = visible ? '' : 'none';
      });
      svg.classList.remove('opacity-0');
      updateProgress();
    }

    function updateProgress() {
      // Progress line: follows the active section's position + scroll progress within it
      const { positions } = computeLayout();
      let fillY = Y_START;
      if (activeSection) {
        const activeIdx = sectionIds.indexOf(activeSection);
        const nextId = sectionIds[activeIdx + 1];
        const activeY = positions.get(activeSection) ?? Y_START;
        const nextY = nextId ? positions.get(nextId) ?? activeY : activeY + BASE_SLOT;

        const activeEl = document.getElementById(activeSection);
        const nextEl = nextId ? document.getElementById(nextId) : null;
        if (activeEl) {
          const aTop = activeEl.getBoundingClientRect().top + window.scrollY - STICKY_HEADER_OFFSET;
          const nTop = nextEl
            ? nextEl.getBoundingClientRect().top + window.scrollY - STICKY_HEADER_OFFSET
            : document.documentElement.scrollHeight - window.innerHeight;
          const range = Math.max(1, nTop - aTop);
          const progress = Math.max(0, Math.min(1, (window.scrollY - aTop) / range));
          fillY = activeY + progress * (nextY - activeY);
        }
      }
      const fill = document.getElementById('toc-fill');
      if (fill) fill.setAttribute('y2', String(fillY));

      // Filled dot state
      allHeadings.forEach((h) => {
        const inner = svg.querySelector(`[data-toc-inner="${CSS.escape(h.id)}"]`);
        if (!inner) return;
        const rect = h.getBoundingClientRect();
        const isPassed = rect.top < window.innerHeight * 0.4;
        inner.setAttribute('fill', isPassed ? 'currentColor' : 'var(--bg)');
      });
    }

    function onScroll() {
      const newActive = computeActiveSection();
      if (newActive !== activeSection) {
        activeSection = newActive;
        applyLayout();
      } else {
        updateProgress();
      }
    }

    function fullRerender() {
      rebuildIndex();
      activeSection = computeActiveSection();
      lastSignature = allHeadings.map((h) => h.id).join('|');
      if (allHeadings.length < 2) {
        root.style.display = 'none';
        return;
      }
      root.style.display = '';
      buildElements();
      // Apply layout twice: first without animation (initial placement),
      // then re-read to let transitions pick up on subsequent changes.
      applyLayout();
    }

    let raf = 0;
    function scheduleScroll() {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        onScroll();
      });
    }

    let moTimer = 0;
    const debouncedRerender = () => {
      clearTimeout(moTimer);
      moTimer = window.setTimeout(() => {
        const newHeadings = queryHeadings();
        const sig = newHeadings.map((h) => h.id).join('|');
        if (sig !== lastSignature) {
          fullRerender();
        } else {
          activeSection = computeActiveSection();
          applyLayout();
        }
      }, 150);
    };

    window.addEventListener('scroll', scheduleScroll, { passive: true });
    window.addEventListener('resize', debouncedRerender, { passive: true });

    const mo = new MutationObserver(debouncedRerender);
    mo.observe(content, { childList: true, subtree: true });

    if (document.readyState === 'complete') fullRerender();
    else window.addEventListener('load', fullRerender);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initToc);
  } else {
    initToc();
  }
</script>
