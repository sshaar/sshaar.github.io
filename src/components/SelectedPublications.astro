---
import fs from 'node:fs';
import path from 'node:path';
import type { Publication } from '../data/publications';
import type { ResearchProject } from '../data/projects';
import { COLOR_CLASSES } from '../data/projects';

interface Props {
  publications: Publication[];
  projects: ResearchProject[];
  me: string;
}

const { publications, projects, me } = Astro.props;

const sorted = [...publications].sort((a, b) => b.year - a.year);

const IMAGE_EXTS = ['.png', '.jpg', '.jpeg', '.webp', '.gif', '.svg', '.avif'];
const pubsDir = path.resolve('./public/publications');
const available = fs.existsSync(pubsDir) ? fs.readdirSync(pubsDir) : [];

function resolveImage(image: string | undefined): string | null {
  if (!image) return null;
  if (/^(https?:)?\/\//.test(image)) return image;
  const cleaned = image.replace(/^\/+/, '');
  const fullPath = path.join('./public', cleaned);
  if (path.extname(cleaned) && fs.existsSync(fullPath)) return '/' + cleaned;
  const basename = path.basename(cleaned, path.extname(cleaned));
  const match = available.find((f) => {
    const ext = path.extname(f).toLowerCase();
    return IMAGE_EXTS.includes(ext) && path.basename(f, ext) === basename;
  });
  return match ? `/publications/${match}` : null;
}
---

<ul class="space-y-10">
  {sorted.map((pub) => {
    const resolvedImage = resolveImage(pub.image);
    return (
      <li class="grid items-start gap-4 sm:grid-cols-[11rem_1fr] sm:gap-6">
        <div class="max-w-[16rem] sm:max-w-none">
          {resolvedImage ? (
            <img
              src={resolvedImage}
              alt={`Figure from ${pub.title}`}
              loading="lazy"
              class="aspect-[4/3] w-full rounded-lg bg-zinc-100 object-cover ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800"
            />
          ) : (
            <div
              class="flex aspect-[4/3] w-full items-center justify-center rounded-lg bg-zinc-100/60 px-3 text-center ring-1 ring-zinc-200 dark:bg-zinc-900/60 dark:ring-zinc-800"
              aria-hidden="true"
            >
              <span class="font-mono text-[11px] uppercase tracking-widest text-ink-subtle dark:text-zinc-500">
                {pub.venueShort ?? pub.venue} {pub.year}
              </span>
            </div>
          )}
        </div>

        <div class="min-w-0">
          <p class="meta mb-1.5">
            {pub.venueShort ?? pub.venue} {pub.year}
            {pub.findings && ' · Findings'}
          </p>
          {pub.award && (
            <p class="mb-1.5 flex items-center gap-1.5 text-xs font-medium text-amber-700 dark:text-amber-400">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                <path d="M4 22h16"></path>
                <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
              </svg>
              {pub.award}
            </p>
          )}
          {pub.url ? (
            <a
              href={pub.url}
              class="font-serif text-lg leading-snug text-ink transition-colors hover:text-accent-700 dark:text-zinc-100 dark:hover:text-accent-300 md:text-xl"
            >
              {pub.title}
            </a>
          ) : (
            <span class="font-serif text-lg leading-snug text-ink dark:text-zinc-100 md:text-xl">
              {pub.title}
            </span>
          )}

          <p class="mt-1.5 text-sm text-ink-muted dark:text-zinc-400">
            {pub.authors.map((a, i) => {
              const sep = i < pub.authors.length - 1 ? ', ' : '';
              return a === me ? (
                <><span class="font-semibold text-ink dark:text-zinc-200">{a}</span>{sep}</>
              ) : (
                <>{a}{sep}</>
              );
            })}
          </p>

          {pub.description && (
            <p class="mt-2 max-w-prose text-sm leading-relaxed text-ink-muted dark:text-zinc-400">
              {pub.description}
            </p>
          )}

          {pub.projects.length > 0 && (
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              {pub.projects.map((slug) => {
                const proj = projects.find((p) => p.slug === slug);
                if (!proj) return null;
                const colors = COLOR_CLASSES[proj.color];
                return (
                  <a
                    href="/publications/"
                    class={`rounded-full px-2 py-0.5 text-[11px] font-medium transition-colors ${colors.tag}`}
                  >
                    {proj.short ?? proj.name}
                  </a>
                );
              })}
            </div>
          )}
        </div>
      </li>
    );
  })}
</ul>
