---

<ul class={`flex items-center gap-4 ${className}`} aria-label="Social links">
  {links.map((link) => (
    <li>
      <a
        href={link.href}
        aria-label={link.label}
        title={link.label}
        class="block text-ink-muted hover:text-accent-700 dark:text-zinc-300 dark:hover:text-accent-300 transition-colors"
        target={link.href.startsWith('http') ? '_blank' : undefined}
        rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
      >
        <Fragment set:html={link.svg} />
      </a>
    </li>
  ))}
</ul>
