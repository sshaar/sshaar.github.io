---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import SelectedPublications from '../components/SelectedPublications.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';
import { publications, ME } from '../data/publications';
import { projects } from '../data/projects';

const interests = [
  {
    title: 'NLP over long inputs',
    status: 'current' as const,
    summary:
      'Question-answering and summarization over full-length videos and other extended, multi-modal narratives — including the long-form generation some of these tasks demand, and the challenge of evaluating open-ended outputs no fixed reference can capture.',
  },
  {
    title: 'Clinical NLP',
    status: 'current' as const,
    summary:
      'Using LLMs to surface clinical decision patterns from unstructured medical narratives, with a focus on heart failure and heart transplant care.',
  },
  {
    title: 'Automated fact-checking',
    status: 'prior' as const,
    summary:
      'Detecting, verifying, and justifying claim veracity across multi-modal, variable-length inputs.',
  },
  {
    title: 'Propaganda detection',
    status: 'prior' as const,
    summary:
      'Identifying propaganda and persuasion techniques across multi-modal inputs in news articles, memes, and other media.',
  },
  {
    title: 'COVID-19 misinformation',
    status: 'prior' as const,
    summary:
      'Analyzing misinformation, vaccine-related fake news, and the broader infodemic on social platforms during the COVID-19 pandemic.',
  },
];

const experiences = (await getCollection('experiences')).sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);

const selectedPubs = publications.filter((p) => p.selected);

// Format in UTC — frontmatter dates parse as UTC midnight, so local-time
// formatting shifts them a month early in US timezones.
const fmtMonth = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
const fmtMonthYear = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });

// "May — Aug 2025" when the range stays within one year, otherwise
// "Jul 2019 — Aug 2021".
const fmtRange = (start: Date, end: Date | undefined, ongoing: boolean) => {
  if (ongoing || !end) return `${fmtMonthYear(start)} — present`;
  if (start.getUTCFullYear() === end.getUTCFullYear())
    return `${fmtMonth(start)} — ${fmtMonthYear(end)}`;
  return `${fmtMonthYear(start)} — ${fmtMonthYear(end)}`;
};

const sections = [
  { id: 'about', label: 'About' },
  { id: 'news', label: 'News' },
  { id: 'research', label: 'Research' },
  { id: 'experience', label: 'Experience' },
  { id: 'publications', label: 'Publications' },
  { id: 'education', label: 'Education' },
  { id: 'contact', label: 'Contact' },
];

const news = [
  {
    date: 'Jun 2026',
    body: '<em>MovieRecapsQA</em>, our open-ended benchmark for question-answering over full-length movies, appeared at <strong>CVPR 2026</strong>.',
  },
  {
    date: 'May 2026',
    body: 'Our <strong>JHLT</strong> paper with NewYork-Presbyterian uses an LLM for thematic analysis of accepted heart-transplant exception requests.',
  },
  {
    date: 'Aug 2025',
    body: 'Wrapped up a summer as an Applied Scientist Intern at <strong>Zillow</strong>, building conversational real-estate agents with reinforcement learning.',
  },
  {
    date: 'May 2025',
    body: '"Are Triggers Needed for Document-Level Event Extraction?" was published in <strong>TACL</strong>. Also finished an ML research engineering internship at <strong>Scale AI</strong>.',
  },
];

const education = [
  { school: 'Cornell University', location: 'Ithaca, NY', degree: 'PhD in Computer Science', detail: 'Advised by Prof. Claire Cardie · Minor in Applied Mathematics · Graduating Jan 2027', award: 'University Fellowship (2021)', dates: '2021 — present' },
  { school: 'Cornell University', location: 'Ithaca, NY', degree: 'MS in Computer Science', dates: '2021 — 2024' },
  { school: 'Carnegie Mellon University', location: 'Doha, Qatar', degree: 'BS in Computer Science', detail: 'Minor in Mathematics · University Honors', award: '50% Academic Merit Scholarship (2015)', dates: '2015 — 2019' },
];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Shaden Shaar',
  url: 'https://sshaar.github.io',
  image: 'https://sshaar.github.io/portrait.jpg',
  jobTitle: 'PhD Candidate in Computer Science',
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Cornell University',
    url: 'https://www.cornell.edu',
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Cornell University', url: 'https://www.cornell.edu' },
    { '@type': 'CollegeOrUniversity', name: 'Carnegie Mellon University', url: 'https://www.cmu.edu' },
  ],
  sameAs: [
    'https://github.com/sshaar',
    'https://scholar.google.com/citations?user=yMArLRcAAAAJ',
    'https://www.linkedin.com/in/shaden-shaar/',
    'https://x.com/shadenshaar',
  ],
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <div class="page-shell pt-14 md:pt-20">
    <SectionNav sections={sections} />

    <div class="page-main">
      <!-- Hero -->
      <section id="about" class="pb-16">
        <ScrollReveal>
          <p class="section-label mb-3">PhD Candidate · Cornell University</p>
          <h1 class="font-serif text-4xl leading-tight text-ink dark:text-zinc-100 md:text-5xl">
            Shaden Shaar
          </h1>
          <div class="mt-8 grid items-start gap-8 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-10">
            <div class="order-2 min-w-0 sm:order-1">
              <div class="space-y-4 leading-relaxed text-ink-muted dark:text-zinc-300">
                <p>
                  I'm a PhD candidate in Computer Science at
                  <a href="https://www.cornell.edu" class="link">Cornell University</a>, advised by
                  Prof. <a href="https://www.cs.cornell.edu/home/cardie/" class="link">Claire Cardie</a>.
                  My thesis focuses on <strong class="text-ink dark:text-zinc-100">NLP tasks over long
                  inputs</strong> — some of which involve long-form generation — most recently
                  open-ended question-answering and summarization over full-length videos,
                  which produced <em>MovieRecapsQA</em> (CVPR 2026). In parallel, I collaborate with
                  <a href="https://www.nyp.org/" class="link">NewYork-Presbyterian Hospital</a> on
                  clinical NLP for heart failure and heart transplant care.
                </p>
                <p>
                  Before Cornell, I was at the
                  <a href="https://www.hbku.edu.qa/en/qcri" class="link">Qatar Computing Research Institute (QCRI, HBKU)</a>
                  working with Prof.
                  <a href="https://mbzuai.ac.ae/study/faculty/preslav-nakov/" class="link">Preslav Nakov</a>
                  on automated fact-checking, propaganda detection, and COVID-19 misinformation —
                  including <em>That Is a Known Lie</em> (ACL 2020), which introduced the task of
                  detecting previously fact-checked claims.
                </p>
              </div>
              <SocialLinks class="mt-7" iconSize={20} />
            </div>
            <img
              src="/portrait.jpg"
              alt="Shaden Shaar"
              width="280"
              height="326"
              class="order-1 aspect-[3/4] w-44 shrink-0 rounded-xl object-cover ring-1 ring-zinc-200 dark:ring-zinc-800 sm:order-2 sm:w-56 md:w-64"
            />
          </div>
        </ScrollReveal>
      </section>

      <!-- News -->
      <section id="news" class="scroll-mt-24 border-t border-zinc-200 py-14 dark:border-zinc-800">
        <ScrollReveal>
          <p class="section-label mb-6">News</p>
          <ul class="space-y-4">
            {news.map((n) => (
              <li class="grid grid-cols-[5.5rem_1fr] gap-4 sm:gap-6">
                <span class="meta pt-0.5">{n.date}</span>
                <p class="text-[15px] leading-relaxed text-ink-muted dark:text-zinc-300" set:html={n.body} />
              </li>
            ))}
          </ul>
        </ScrollReveal>
      </section>

      <!-- Research interests -->
      <section id="research" class="scroll-mt-24 border-t border-zinc-200 py-14 dark:border-zinc-800">
        <ScrollReveal>
          <h2 class="section-heading mb-7">Research interests</h2>
          <ul class="space-y-6">
            {interests.map((it) => (
              <li>
                <p class="font-medium text-ink dark:text-zinc-100">
                  {it.title}
                  {it.status === 'prior' && (
                    <span class="ml-2 align-middle font-mono text-[10px] font-normal uppercase tracking-widest text-ink-subtle dark:text-zinc-500">prior</span>
                  )}
                </p>
                <p class="mt-1 max-w-prose text-sm leading-relaxed text-ink-muted dark:text-zinc-400">
                  {it.summary}
                </p>
              </li>
            ))}
          </ul>
        </ScrollReveal>
      </section>

      <!-- Experience -->
      <section id="experience" class="scroll-mt-24 border-t border-zinc-200 py-14 dark:border-zinc-800">
        <ScrollReveal>
          <h2 class="section-heading mb-8">Experience</h2>
          <ul class="space-y-8">
            {experiences.map((e) => (
              <li class="grid gap-1.5 sm:grid-cols-[8.5rem_1fr] sm:gap-6">
                <span class="meta sm:pt-1">
                  {fmtRange(e.data.startDate, e.data.endDate, e.data.ongoing)}
                </span>
                <div>
                  <h3 class="font-medium text-ink dark:text-zinc-100">
                    {e.data.title} · <span class="font-normal">{e.data.organization}</span>
                  </h3>
                  {e.data.location && (
                    <p class="mt-0.5 text-xs text-ink-subtle dark:text-zinc-500">{e.data.location}</p>
                  )}
                  {e.data.bullets && e.data.bullets.length > 0 ? (
                    <ul class="mt-2 space-y-1.5 text-sm leading-relaxed text-ink-muted marker:text-zinc-400 dark:text-zinc-400 dark:marker:text-zinc-600 list-disc pl-4">
                      {e.data.bullets.map((b) => <li>{b}</li>)}
                    </ul>
                  ) : e.data.description ? (
                    <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-zinc-400">{e.data.description}</p>
                  ) : null}
                </div>
              </li>
            ))}
          </ul>
        </ScrollReveal>
      </section>

      <!-- Selected publications -->
      <section id="publications" class="scroll-mt-24 border-t border-zinc-200 py-14 dark:border-zinc-800">
        <ScrollReveal>
          <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h2 class="section-heading">Selected publications</h2>
            <a href="/publications/" class="text-sm text-ink-muted dark:text-zinc-400 link">
              All {publications.length} publications →
            </a>
          </div>
          <p class="mb-10 text-sm leading-relaxed text-ink-muted dark:text-zinc-400">
            A few representative papers. The full list is on the
            <a href="/publications/" class="link">publications page</a> and
            <a href="https://scholar.google.com/citations?user=yMArLRcAAAAJ" class="link">Google Scholar</a>.
          </p>
          <SelectedPublications publications={selectedPubs} projects={projects} me={ME} />
        </ScrollReveal>
      </section>

      <!-- Education -->
      <section id="education" class="scroll-mt-24 border-t border-zinc-200 py-14 dark:border-zinc-800">
        <ScrollReveal>
          <h2 class="section-heading mb-8">Education</h2>
          <ul class="space-y-5">
            {education.map((e) => (
              <li class="grid gap-1 sm:grid-cols-[8.5rem_1fr] sm:gap-6">
                <span class="meta sm:pt-0.5">{e.dates}</span>
                <div>
                  <p class="font-medium text-ink dark:text-zinc-100">{e.degree}</p>
                  <p class="text-sm text-ink-muted dark:text-zinc-400">{e.school} · {e.location}</p>
                  {e.detail && <p class="mt-0.5 text-xs text-ink-subtle dark:text-zinc-500">{e.detail}</p>}
                  {e.award && (
                    <p class="mt-0.5 text-xs font-medium text-ink-muted dark:text-zinc-300">{e.award}</p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </ScrollReveal>
      </section>

      <!-- Contact -->
      <section id="contact" class="scroll-mt-24 border-t border-zinc-200 py-14 pb-8 dark:border-zinc-800">
        <ScrollReveal>
          <h2 class="section-heading mb-4">Contact</h2>
          <p class="max-w-xl leading-relaxed text-ink-muted dark:text-zinc-300">
            The best way to reach me is by email at
            <a href="mailto:sshaar31@gmail.com" class="link font-medium text-ink dark:text-zinc-100">sshaar31@gmail.com</a>
            — whether about roles, collaborations, or anything related to the work. A printable CV
            is available as a <a href="/cv.pdf" target="_blank" rel="noopener noreferrer" class="link">PDF</a>.
          </p>
          <SocialLinks class="mt-6" iconSize={20} />
        </ScrollReveal>
      </section>
    </div>
  </div>
</BaseLayout>
